#!/usr/bin/env bash
set -eo pipefail

# Run every exercise's reference solution against its tests, using the locally
# installed Zig. Concept Exercises keep their reference solution in
# '.meta/exemplar.zig' and Practice Exercises in '.meta/example.zig'.

execute_test() {
  (
    cd "${1}"
    # Get the exercise name from the directory
    local exercise_name
    exercise_name=$(echo "$1" | tr '-' '_')

    printf '%s\n' "Running tests for ${1}..." >&2

    # Copy the reference solution over the stub, under the name the test file
    # imports, then run the tests exactly as a student would.
    local reference
    if [[ -f "./.meta/exemplar.zig" ]]; then
      reference="./.meta/exemplar.zig"
    elif [[ -f "./.meta/example.zig" ]]; then
      reference="./.meta/example.zig"
    else
      printf '%s\n' "Error: ${1} lacks its '.meta/exemplar.zig' or '.meta/example.zig' file" >&2
      exit 1
    fi

    mv "${reference}" "${exercise_name}".zig
    # No building required, just test it
    zig test "test_${exercise_name}.zig"
    printf '\n' >&2
  )
}

main() {
  # Move to the root directory of the repo so you can run this script from anywhere
  local script_dir
  script_dir="$(cd "$(dirname "$0")" >/dev/null 2>&1 && pwd)"
  cd "${script_dir}"/..

  if [[ ! -d "exercises/practice" ]]; then
    printf '%s\n' "Error: the 'exercises/practice' directory is missing" >&2
    exit 1
  fi

  # Clear up any previous run
  rm -rf build
  mkdir build

  # Both kinds of exercise are laid out the same way, so they can be copied
  # into one flat working directory and tested identically.
  cp -r exercises/practice/* build/
  if [[ -d "exercises/concept" ]]; then
    cp -r exercises/concept/* build/
  fi

  (
    cd build/

    # Allow specifying which tests to run as arguments
    if [[ $# -gt 0 ]]; then
      local exercises=("$@")
      for exercise in "${exercises[@]}"; do
        if [[ ! -d "${exercise}" ]]; then
          printf '%s\n' "Error: the specified exercise '${exercise}' does not exist" >&2
          exit 1
        fi
      done
    else
      local exercises=(*)
    fi

    for exercise in "${exercises[@]}"; do
      execute_test "${exercise}"
    done
  )

  # Clean up duplicate exercises
  rm -rf build
}

main "$@"
