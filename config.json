  "key_features": [
    {
      "title": "Simple",
      "content": "Zig lets you focus on debugging your application rather than your programming language knowledge.",
      "icon": "easy"
    },
    {
      "title": "Comptime",
      "content": "Zig has a fresh approach to metaprogramming based on compile-time code execution and lazy evaluation",
      "icon": "powerful"
    },
    {
      "title": "Performance",
      "content": "Zig produces fast and memory efficient executables: you are free to manage memory yourself.",
      "icon": "fast"
    },
